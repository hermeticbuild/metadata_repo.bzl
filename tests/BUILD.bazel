# ---- PURL, checksum and integrity generation ----

metadata_test(
    name = "zlib_tgz_metadata_test",
    repo = "zlib",
    expect = [
        "pkg:generic/zlib@1.3.1?checksum=sha256:" + ZLIB_TGZ_SHA256,
        "download_url=https:%2F%2Fgithub.com%2Fmadler%2Fzlib%2Freleases%2Fdownload%2Fv1.3.1%2Fzlib-1.3.1.tar.gz",
        "file_name=zlib-1.3.1.tar.gz",
        # sha256 given as hex is also exposed as an SRI integrity value
        ZLIB_TGZ_SRI,
    ],
)

metadata_test(
    name = "zlib_zip_metadata_test",
    repo = "zlib_zip",
    expect = [
        "pkg:github/madler/zlib@v1.3.1?checksum=sha256:50b24b47bf19e1f35d2a21ff36d2a366638cdf958219a66f30ce0861201760e6",
        ZLIB_ZIP_SRI,
    ],
)

metadata_test(
    name = "skylib_sha512_metadata_test",
    repo = "skylib",
    expect = [
        "pkg:github/bazelbuild/bazel-skylib@1.8.2?checksum=sha512:9d0c7d922b00f60411677dffc85126307a0cacc6e8b8f6f345ab6c3776f8e52b85a2e8dfaab53c206433316dece860ab824cee13d09cb7e01732b5538c9c7e87",
        SKYLIB_SRI512,
        "!sha256",
    ],
)

metadata_test(
    name = "skylib_purl_options_metadata_test",
    repo = "skylib_purl",
    expect = [
        "pkg:github/bazelbuild/bazel-skylib@1.8.2?arch=any&checksum=sha256:" + SKYLIB_SHA256,
        "download_url=https:%2F%2Fmirror.example.com%2Fskylib.tar.gz",
        "file_name=custom-name.tgz",
        "repository_url=https:%2F%2Frepo.example.com%2Fbazelbuild",
        SKYLIB_SRI256,
    ],
)

metadata_test(
    name = "skylib_unversioned_metadata_test",
    repo = "skylib_unversioned",
    expect = [
        "pkg:generic/skylib?checksum=sha256:" + SKYLIB_SHA256,
        "!skylib@",
    ],
)

metadata_test(
    name = "http_file_metadata_test",
    repo = "license",
    expect = [
        "pkg:generic/zlib-license@1.3.1?checksum=sha256:" + LICENSE_SHA256,
        "download_url=https:%2F%2Fraw.githubusercontent.com%2Fmadler%2Fzlib%2Fv1.3.1%2FLICENSE",
        LICENSE_SRI,
    ],
)

metadata_test(
    name = "http_file_integrity_metadata_test",
    repo = "license_default",
    expect = [
        # SRI input is also exposed as a hex checksum qualifier
        "checksum=sha256:" + LICENSE_SHA256,
        LICENSE_SRI,
    ],
)

metadata_test(
    name = "http_jar_metadata_test",
    repo = "failureaccess",
    expect = [
        "pkg:maven/com.google.guava/failureaccess@1.0.2?checksum=sha256:" + JAR_SHA256,
        "file_name=failureaccess-1.0.2.jar",
        JAR_SRI,
    ],
)

metadata_test(
    name = "git_commit_metadata_test",
    repo = "git_commit",
    integrity = False,
    expect = [
        "pkg:github/bazelbuild/bazel-skylib@" + SKYLIB_COMMIT + "?" + SKYLIB_VCS,
    ],
)

metadata_test(
    name = "git_tag_metadata_test",
    repo = "git_tag",
    integrity = False,
    expect = [
        # the tag is resolved to the commit in vcs_url
        "pkg:github/bazelbuild/bazel-skylib@1.8.2?" + SKYLIB_VCS,
    ],
)

