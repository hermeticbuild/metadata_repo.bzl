# ---- Attributes only available on our rules ----

tree_listing(
    name = "zlib_files_listing",
    srcs = ["@zlib_files//:srcs"],
)

sh_test(
    name = "http_archive_files_test",
    srcs = ["assert_contains.sh"],
    args = [
        "$(rlocationpath :zlib_files_listing)",
        "--",
        "OVERLAY.txt ",
        "zlib.h ",
    ],
    data = [":zlib_files_listing"],
)

tree_listing(
    name = "zlib_patched_listing",
    srcs = ["@zlib_patched//:srcs"],
)

sh_test(
    name = "http_archive_patch_cmds_test",
    srcs = ["assert_contains.sh"],
    args = [
        "$(rlocationpath :zlib_patched_listing)",
        "--",
        "PATCHED.txt ",
    ],
    data = [":zlib_patched_listing"],
)

# ---- SBOM generation ----

# The SBOM aspect only collects metadata from rule targets (applicable_licenses),
# not from source files, so the repos are referenced through filegroups/java_import.
filegroup(
    name = "all_external",
    srcs = [
        "@failureaccess//jar",
        "@git_commit//:srcs",
        "@license//file",
        "@skylib//:srcs",
        "@zlib//:srcs",
        "@zlib_zip//:srcs",
    ],
)

sbom(
    name = "all_sbom",
    require_root_metadata = False,
    target = ":all_external",
)

cyclonedx(
    name = "all_cyclonedx",
    sbom = ":all_sbom",
)

spdx(
    name = "all_spdx",
    sbom = ":all_sbom",
)

sh_test(
    name = "cyclonedx_sbom_test",
    srcs = ["assert_contains.sh"],
    args = [
        "$(rlocationpath :all_cyclonedx)",
        "--",
        "pkg:generic/zlib@1.3.1",
        "pkg:github/madler/zlib@v1.3.1",
        "pkg:github/bazelbuild/bazel-skylib@1.8.2",
        "pkg:github/bazelbuild/bazel-skylib@" + SKYLIB_COMMIT,
        "pkg:generic/zlib-license@1.3.1",
        "pkg:maven/com.google.guava/failureaccess@1.0.2",
    ],
    data = [":all_cyclonedx"],
)

sh_test(
    name = "spdx_sbom_test",
    srcs = ["assert_contains.sh"],
    args = [
        "$(rlocationpath :all_spdx)",
        "--",
        "pkg:generic/zlib@1.3.1",
        "pkg:github/madler/zlib@v1.3.1",
        "pkg:github/bazelbuild/bazel-skylib@1.8.2",
        "pkg:maven/com.google.guava/failureaccess@1.0.2",
    ],
    data = [":all_spdx"],
)

# ---- license attribute ----

license(
    name = "zlib_license",
    kind = "@package_metadata//licenses/spdx:Zlib",
    visibility = ["//visibility:public"],
)

sh_test(
    name = "license_attribute_test",
    srcs = ["assert_contains.sh"],
    args = [
        "$(rlocationpath @zlib_licensed//:package_metadata)",
        "$(rlocationpath :zlib_license)",
        "--",
        "pkg:generic/zlib@1.3.1",
        "build.bazel.attribute.integrity",
        "build.bazel.attribute.license",
        # license attribute file content
        "@@//:zlib_license",
    ],
    data = [
        ":zlib_license",
        "@zlib_licensed//:package_metadata",
    ],
)
